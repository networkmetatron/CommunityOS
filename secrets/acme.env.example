# CommunityOS ACME DNS-01 secrets — Let's Encrypt public certificates
# Install path: /opt/communityos/secrets/acme.env
# Permissions:  sudo chmod 600 /opt/communityos/secrets/acme.env
#               sudo chown root:root /opt/communityos/secrets/acme.env
# Never commit real tokens.

# Required
ACME_EMAIL=admin@example.com
ACME_DNS_PROVIDER=cloudflare

# Cloudflare (Zone:DNS:Edit on the zone that holds DOMAIN_BASE)
CLOUDFLARE_API_TOKEN=

# Optional: pin a Caddy image that includes your DNS plugin
# Default for cloudflare: iarekylew00t/caddy-cloudflare:2.9.1
# CADDY_IMAGE=iarekylew00t/caddy-cloudflare:2.9.1

# Optional: prefer wildcard DOMAIN_BASE + *.DOMAIN_BASE (default 1)
ACME_WILDCARD=1

# Optional: Let's Encrypt staging (test only)
# ACME_STAGING=0
# ACME_CA=https://acme-v02.api.letsencrypt.org/directory
